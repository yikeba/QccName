# qccname 节点配置（P2P，v1.0 公网测试）
# 放在启动目录 ./qccname.properties 或 ~/qccname/config/qccname.properties（先找前者）。

# ═══ 必填 3 项 ═══════════════════════════════════════════════════════════

# 本机 QCC 地址（明文；钱包托管完成后改为节点钱包签名）。不填时用代码 QccNameConfig.DEFAULT_NODE_ID
nodeId=QWasmDyBQzCTdUhj6NLyfAzU6z5sTSdhM1
# 节点间 AES-256-GCM 密钥，64 位 hex，所有节点相同。生成：openssl rand -hex 32
# 只放在服务器配置文件里，不要提交到代码仓库。

clusterKey=28a3bbe4079ad84f5c84c4552df2e1f92029ff541df6b9f9034254b9d84e2d9f
# 已在运行的任意节点 IP:端口，逗号分隔，能连上一个即可（端口省略时为 9180）；IPv6 写成 [地址]:端口
# 第一台（创世节点）留空 —— seeds 为空且本地无数据，本机即成为主节点
# 配了 seeds 但都连不上时会一直重试，不会自封为主节点

seeds=
role=core
# 本机公告 IP。空 = 自动判定：网卡上的公网 IPv4 优先，否则全局 IPv6。
# AWS / GCP / Azure 等 1:1 NAT 云主机网卡上看不到公网 IP，必须填写

advertiseIp=192.168.100.12



# ═══ 可选 ═════════════════════════════════════════════════════════════
# 本机端口
#port=9180


# 角色。auto（默认）：公网 IPv4 → 核心（参与生产 / 备份 / 选举）；只有 IPv6 或 NAT → 冗余（只同步与查询）
#role=auto

# QCC 公链 API，逗号分隔，按顺序故障切换。不填使用代码 QccNameConfig.DEFAULT_CHAINS
#chains=http://45.92.158.123:9080,http://192.131.142.226:9080

# 协议上链后必须填写 protocolHash（启动时校验）
#protocol=qcc-name-v1.0.0.json
#protocolHash=
#instance=qccname-test
#home=/opt/qccname/data
#bind=::
